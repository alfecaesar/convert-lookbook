<div
  data-react-component="product-lookbook"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-products-per-row="{{ section.settings.products_per_row }}"
  data-show-price="{{ section.settings.show_price }}"
  data-show-compare-at-price="{{ section.settings.show_compare_at_price }}"
  data-color-scheme="{{ section.settings.color_scheme }}"
  data-country="{{ localization.country.iso_code }}"
></div>

{% schema %}
{
  "name": "Product Lookbook",
  "settings": [
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_product_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_at_price",
      "label": "Show compare-at price",
      "default": true
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Product Lookbook"
    }
  ]
}
{% endschema %}